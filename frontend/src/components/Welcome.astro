---
import '../styles/global.css';
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>GIA</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Honk:MORF@3&family=IBM+Plex+Sans+Thai:wght@100;200;300;400;500;600;700&family=Iosevka+Charon+Mono:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&family=Jersey+10&family=Poetsen+One&family=Walter+Turncoat&display=swap" rel="stylesheet">

<style>
        .poetsen-one-regular {
            font-family: "Poetsen One", sans-serif;
            font-weight: 400;
            font-style: normal;
        }
        .tilt-element {
            transform-style: preserve-3d;
            will-change: transform, box-shadow;
        }
.card-container {
    width: min(30rem, calc(100vw - 2rem));
    margin-inline: auto;
    perspective: 1800px;
}

#tilt-wrapper {
    width: 100%;
    background: transparent;
    box-shadow: none;
    transform: none;
}
.card-flipper > div {
    grid-area: 1 / 1;
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
    border-radius: 1.5rem;
}
        .card-back {
            transform: rotateY(180deg);
        }
        .card-flipper.is-flipped {
            transform: rotateY(180deg);
        }
        
.card-flipper {
    display: grid;
    position: relative;
    width: 100%;
    transform: rotateY(0deg);
    transform-origin: 50% 50%;
    transform-style: preserve-3d;
    transition: transform 0.8s ease-in-out;
}

.card-front {
    transform: rotateY(0deg);
}

.card-back {
    transform: rotateY(180deg);
}

.card-flipper.is-flipped {
    transform: rotateY(180deg);
}
    </style>
</head>
<body class="bg-primary overflow-hidden">
    <div class="absolute inset-0 md:ml-12 ml-20 -mt-16 bg-primary bg-[url('/images/patron.png')] bg-repeat-round h-screen opacity-30"></div>

    <div id="interactive-area" class="relative w-full h-screen ">

        <!-- Botón: Crea una cuenta -->
        <div class="absolute z-9 w-full flex justify-center items-center md:mt-[29rem] mt-[24.5rem]">
            <div id="create-account-card" class="duration-500 transition-all ease-in-out opacity-100 translate-y-0 tilt-element hover:cursor-pointer bg-blue md:rounded-3xl rounded p-16 pb-3 px-10 md:min-w-[25rem] max-w-[25rem] flex flex-col gap-4 shadow-md justify-center items-center md:mt-[8rem] mt-[5rem]">
                <h1 class="poetsen-one-regular text-primary font-bold text-center select-none">
                    Crea una cuenta
                </h1>
            </div>
        </div>

        <!-- Botón: Tengo una cuenta -->
        <div class="absolute z-8 w-full flex justify-center items-center md:mt-[29rem] mt-[24.5rem]">
            <div id="login-account-card" class="hidden duration-500 transition-all ease-in-out opacity-0 tilt-element hover:cursor-pointer bg-blue md:rounded-3xl rounded p-16 pb-3 px-10 md:min-w-[25rem] max-w-[25rem] flex flex-col gap-4 shadow-md justify-center items-center md:mt-[4rem] mt-[5rem]">
                <h1 class="poetsen-one-regular text-primary font-bold text-center select-none">
                    Tengo una cuenta
                </h1>
            </div>
        </div>

        <!-- Botón: ¿Qué es GIA? -->
<!-- Botón: ¿Qué es GIA? -->
<div class="absolute z-30 w-full flex justify-center items-center md:mt-[7.8rem] mt-[5rem] overflow-hidden md:h-25 h-12">
    <div id="que-es-card" class="duration-500 transition-all ease-in-out opacity-100 translate-y-0 tilt-element cursor-pointer bg-blue md:rounded-3xl rounded p-16 md:pt-3 pt-1 px-10 md:min-w-[25rem] max-w-[25rem] flex flex-col gap-4 shadow-md justify-center items-center md:mt-[7.8rem] mt-[5rem]">
        <h1 class="poetsen-one-regular text-primary font-bold text-center select-none pointer-events-none">
            ¿Qué es GIA?
        </h1>
    </div>
</div>

        <div class="relative z-10 w-full justify-center grid gap-4 items-center md:mt-[10vh] mt-[1rem]">
            <div class="poetsen-one-regular text-white md:text-9xl text-7xl text-center select-none pointer-events-none">
                GIA
            </div>

            <!-- Contenedor general 3D -->
            <div class="card-container w-full md:min-w-[30rem] max-w-[20rem] mx-auto md:mt-[5rem] mt-[2.5rem]">
                <div id="tilt-wrapper" class="tilt-element w-full shadow-xl md:rounded-3xl rounded bg-secondary" style="transform-style: preserve-3d;">
                    
                    <div id="card-flipper" class="card-flipper w-full grid rounded-3xl">
                        
                        <!-- CARA FRONTAL (Login) -->
                        <div id="form-card" class="card-front bg-secondary rounded-3xl md:p-16 p-8 md:px-10 px-6 w-full flex flex-col gap-4">
                            <form id="login-form" class="flex flex-col gap-4">
                                <label class="select-none poetsen-one-regular text-white md:text-3xl text-2xl" for="email">Correo</label>
                                <input class="rounded shadow-[inset_0_4px_6px_rgba(0,0,0,0.6)] bg-primary text-white placeholder:text-gray-400 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue min-w-full p-2" type="email" id="email" name="email" autocomplete="email" required>
                                <label class="select-none poetsen-one-regular text-white md:text-3xl text-2xl" for="password">Contraseña</label>
                                <input class="rounded shadow-[inset_0_4px_6px_rgba(0,0,0,0.6)] bg-primary text-white placeholder:text-gray-400 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue min-w-full p-2" type="password" id="password" name="password" autocomplete="current-password" required>
                                <div class="w-full items-center flex justify-center gap-4 md:mt-2 mt-2">
                                    <button class="bg-green p-4 text-white font-bold py-2 px-4 rounded shadow-md shadow-black hover:shadow-lg hover:shadow-black hover:transition duration-300 hover:translate-y-[-3px]" type="submit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="100" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check preview-icon"><path d="M20 6 9 17l-5-5"/></svg>
                                    </button>
                                </div>
                                <p id="auth-message" class="text-center text-white" role="status" aria-live="polite"></p>

                            </form>
                        </div>

                        <!-- CARA TRASERA (Registro) -->
                        <div id="register-card" class="card-back bg-secondary rounded-3xl p-10 px-10 w-full flex flex-col gap-4">
                            <form id="register-form" class="flex flex-col gap-3">
                                <label class="select-none poetsen-one-regular text-white md:text-2xl text-1xl" for="reg-name">Nombre</label>
                                <input class="rounded shadow-[inset_0_4px_6px_rgba(0,0,0,0.6)] bg-primary text-white placeholder:text-gray-400 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue min-w-full p-2" type="text" id="reg-name" name="name" autocomplete="name" minlength="3" required>
                                
                                <label class="select-none poetsen-one-regular text-white md:text-2xl text-1xl" for="reg-email">Correo</label>
                                <input class="rounded shadow-[inset_0_4px_6px_rgba(0,0,0,0.6)] bg-primary text-white placeholder:text-gray-400 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue min-w-full p-2" type="email" id="reg-email" name="email" autocomplete="email" required>
                                
                                <label class="select-none poetsen-one-regular text-white md:text-2xl text-1xl" for="reg-password">Contraseña</label>
                                <input class="rounded shadow-[inset_0_4px_6px_rgba(0,0,0,0.6)] bg-primary text-white placeholder:text-gray-400 border border-gray-600 focus:outline-none focus:ring-2 focus:ring-blue min-w-full p-2" type="password" id="reg-password" name="password" autocomplete="new-password" minlength="3" required>
                                
                                <div class="w-full items-center flex justify-center gap-4 mt-4">
                                    <button class="bg-green p-4 text-white font-bold py-2 px-4 rounded shadow-md shadow-black hover:shadow-lg hover:shadow-black hover:transition duration-300 hover:translate-y-[-3px]" type="submit">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="100" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-check preview-icon"><path d="M20 6 9 17l-5-5"/></svg>
                                    </button>

                                </div>

                            </form>
                        </div>

                    </div>
                </div>
            </div>
        </div>

    </div>

    <!-- Script con animación hacia abajo para ¿Qué es GIA? -->
    <script>
    const createAccountCard = document.getElementById('create-account-card');
    const cardFlipper = document.getElementById('card-flipper');
    const loginAccountCard = document.getElementById('login-account-card');
    const queEsCard = document.getElementById('que-es-card');
    const loginForm = document.getElementById('login-form');
    const registerForm = document.getElementById('register-form');
    const authMessage = document.getElementById('auth-message');

    const apiUrl = (import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:8000/api').replace(/\/$/, '');

    function getErrorMessage(data) {
        if (typeof data.error === 'string') return data.error;
        if (data.error && typeof data.error === 'object') {
            return Object.values(data.error).flat().join(' ');
        }
        return 'No se pudo completar la solicitud. Intenta de nuevo.';
    }

    async function submitAuthForm(form, endpoint, successMessage) {
        const submitButton = form.querySelector('button[type="submit"]');
        authMessage.textContent = '';
        submitButton.disabled = true;

        try {
            const response = await fetch(`${apiUrl}/${endpoint}`, {
                method: 'POST',
                headers: {
                    'Accept': 'application/json',
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(Object.fromEntries(new FormData(form))),
            });
            const data = await response.json();

            if (!response.ok) {
                throw new Error(getErrorMessage(data));
            }
            if (typeof data.success !== 'string') {
                throw new Error('La respuesta de autenticación no contiene un token válido.');
            }

            sessionStorage.setItem('auth_token', data.success);
            if (endpoint === 'login' && data.user?.is_admin === false) {
                window.location.replace('/dashboard');
                return;
            }

            authMessage.textContent = successMessage;
            form.reset();
        } catch (error) {
            authMessage.textContent = error instanceof Error
                ? error.message
                : 'No se pudo conectar con el servidor.';
        } finally {
            submitButton.disabled = false;
        }
    }

    loginForm.addEventListener('submit', (event) => {
        event.preventDefault();
        submitAuthForm(loginForm, 'login', 'Sesión iniciada correctamente.');
    });

    registerForm.addEventListener('submit', (event) => {
        event.preventDefault();
        submitAuthForm(registerForm, 'register', 'Cuenta creada e inicio de sesión completado.');
    });

    if (createAccountCard && cardFlipper && loginAccountCard && queEsCard) {
        
        // Función auxiliar para animar "¿Qué es GIA?" hacia abajo y regresarlo
        function animateQueEsCard() {
            // Mover hacia abajo y desvanecer mientras gira la tarjeta
            queEsCard.classList.remove('opacity-100', 'translate-y-0');
            queEsCard.classList.add('opacity-0', 'translate-y-[50%]');

            // Regresar a su posición original al terminar el giro (800ms)
            setTimeout(() => {
                queEsCard.classList.remove('opacity-0', 'translate-y-[50%]');
                queEsCard.classList.add('opacity-100', 'translate-y-0');
            }, 800);
        }

        // 1. Al hacer clic en "Crea una cuenta"
        createAccountCard.addEventListener('click', () => {
            cardFlipper.classList.add('is-flipped');

            createAccountCard.classList.remove('opacity-100', 'translate-y-0');
            createAccountCard.classList.add('opacity-0', 'translate-y-[-100%]');

            loginAccountCard.classList.remove('hidden', 'opacity-0', 'translate-y-0');
            void loginAccountCard.offsetWidth; 
            loginAccountCard.classList.add('opacity-100', 'md:translate-y-[63%]');

            animateQueEsCard();

            setTimeout(() => {
                createAccountCard.classList.add('hidden');
            }, 800);
        });

        // 2. Al hacer clic en "Tengo una cuenta"
        loginAccountCard.addEventListener('click', () => {
            cardFlipper.classList.remove('is-flipped');

            loginAccountCard.classList.remove('opacity-100', 'md:translate-y-[63%]');
            loginAccountCard.classList.add('opacity-0', 'translate-y-0');

            createAccountCard.classList.remove('hidden', 'opacity-0', 'translate-y-[-100%]');
            void createAccountCard.offsetWidth; 
            createAccountCard.classList.add('opacity-100', 'translate-y-0');

            animateQueEsCard();

            setTimeout(() => {
                loginAccountCard.classList.add('hidden');
            }, 800);
        });
    }
    </script>
</body>
</html>