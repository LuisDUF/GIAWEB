---
import '../styles/global.css';

const { titulo, class: className = '', subtitulo } = Astro.props;

---


<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>GIA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Honk:MORF@3&family=IBM+Plex+Sans+Thai:wght@100;200;300;400;500;600;700&family=Iosevka+Charon+Mono:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&family=Jersey+10&family=Poetsen+One&family=Walter+Turncoat&display=swap" rel="stylesheet">

</head>
<body>

    <div id="interactive-area" class={`relative w-full md:h-full h-[130%] card-base ${className}`}>

        <div class="absolute z-9 w-full flex justify-center items-center md:mt-[22rem] mt-[23rem]">
            <div id="create-account-card" class="duration-500 transition-all ease-in-out opacity-100 translate-y-0 tilt-element hover:cursor-pointer bg-blue md:rounded-3xl rounded p-16 pb-3 px-10 md:min-w-[25rem] max-w-[25rem] flex flex-col gap-4 shadow-md justify-center items-center md:mt-[8rem] mt-[5rem]">
                <h1 class="poetsen-one-regular text-primary font-bold text-center select-none">
                    <div set:html={subtitulo} />
                </h1>
            </div>
        </div>

        <div class="absolute z-0 w-full flex justify-center items-center  overflow-hidden md:h-28 h-20">
            <div id="que-es-card" class="duration-500 transition-all ease-in-out opacity-100 translate-y-0 tilt-element cursor-pointer bg-blue md:rounded-3xl rounded p-16 md:pt-3 pt-1 px-10 md:min-w-[25rem] max-w-[11rem] flex flex-col gap-4 shadow-md justify-center items-center md:mt-[7.8rem] mt-[5rem]">
                <h1 class="poetsen-one-regular text-white font-bold text-center select-none pointer-events-none md:text-3xl text-md ">
                    {titulo}
                </h1>
            </div>
        </div>

        
 <!-- PADRE -->
<div class="relative z-10 md:min-w-[30rem] max-w-[20rem] mx-auto md:mt-[7rem] mt-[5rem] h-[27rem] shadow-xl md:rounded-3xl rounded bg-secondary md:p-6 p-0 py-4 flex flex-col justify-center">
    <slot />
</div>

                <!-- Botón: Crea una cuenta -->

                

    </div>
    
</body>
</html>