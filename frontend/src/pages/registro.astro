---
import Racha from "../components/analiticas/Racha.astro";
import Card from "../components/Card.astro";
import Ejercicio from "../components/Ejercicio.astro";
import ProtectedLayout from "../layouts/ProtectedLayout.astro";
---

<ProtectedLayout>

    <div class="w-full px-10 ">
        <div class="bg-secondary rounded-3xl overflow-x-auto  scrollbar-thumb-blue shadow-inner shadow-black ">
            <div id="tabla-ejercicios" class=" p-10  gap-6 rounded-3xl  grid grid-flow-col grid-rows-1 w-max">
                <div class="text-center p-4 bg-blue text-white text-lg rounded shadow-md shadow-black  poetsen-one-regular hover:cursor-pointer hover:shadow-blue hover:text-shadow-lg  hover:-translate-y-2 transition duration-800 ease-in-out">
                    HOLA
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-5 grid-rows-1 gap-0">
        <div class="col-span-2">

            <div class="grid grid-cols-1 items-center justify-center">
                <Card
                    titulo="Ejercicio"
                    subtitulo = ""
                    class=""
                    classContenido="md:min-w-[30rem] max-w-[20rem] "
                >
                    <Ejercicio/>
                </Card>
            </div>


        </div>
        <div class="col-span-3 col-start-3">


            <div class="grid grid-cols-1 items-center justify-center">
                <Card
                    titulo="Ejercicio"
                    subtitulo = ""
                    class=""
                    classContenido="w-[80%] "
                >
                    <Ejercicio/>
                </Card>
            </div>

        </div>
    </div>
    



    


<script>
    const apiUrl = (import.meta.env.PUBLIC_API_URL ?? 'http://127.0.0.1:8000/api')
        .replace(/\/$/, '');

    async function cargarRegistro() {
        const id = new URLSearchParams(window.location.search).get('id');
        const token = sessionStorage.getItem('auth_token');

        if (!id || !/^\d+$/.test(id)) {
            console.error('No se recibió un ID válido en la URL.');
            return;
        }

        if (!token) {
            console.error('No se encontró la sesión. Inicia sesión nuevamente.');
            return;
        }

        const response = await fetch(
            `${apiUrl}/v1/workout-sessions/${encodeURIComponent(id)}`,
            {
                headers: {
                    Accept: 'application/json',
                    Authorization: `Bearer ${token}`,
                },
            }
        );

        if (!response.ok) {
            throw new Error(`No se pudo obtener el registro (HTTP ${response.status}).`);
        }

        const registro = await response.json();
        console.log(registro); // Aquí puedes mostrar sus datos en la página.
    }

    void cargarRegistro().catch((error) => {
        console.error('Error al cargar el registro:', error);
    });
</script>
</ProtectedLayout>